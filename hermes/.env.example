# ── Host user IDs (for file permission mapping) ──────────
# Auto-detected by run.sh via `id -u` / `id -g` — no need to set here.
# Change the run.sh recipe if you need a non-default mapping.
# HERMES_UID=501
# HERMES_GID=20

# ── LLM Provider ─────────────────────────────────────────
# Option A: Local inference (oMLX, Ollama, LM Studio, vLLM)
#   The default vmnet bridge uses http://192.168.64.1:<port>/v1.
#   Match the reachable host address in both model and provider configuration.
#   The provider config in config.yaml reads its key from OMLX_API_KEY
#   (not OPENAI_API_KEY) — deliberately distinct so Hermes doesn't treat
#   you as an authenticated OpenAI account in the model picker.
OMLX_API_KEY=

# Option B: Ollama Cloud (no local GPU needed)
#   Set provider: ollama-cloud in config.yaml
#   config.yaml.example also selects this as a fallback. It needs credentials
#   and sends requests off-machine when used; remove fallback_model for local-only LLMs.
OLLAMA_API_KEY=

# Option C: External API (OpenAI, Together, Groq, etc.)
#   Set provider: custom + base_url in config.yaml
# OPENAI_API_KEY=sk-...

# ── Tool Services (built into the container) ─────────────
SEARXNG_URL=http://localhost:8080
CAMOFOX_URL=http://localhost:9377

# ── Browser GUI / dashboard (http://localhost:9119) ──────
# The container runs `hermes dashboard` and publishes it to 127.0.0.1:9119.
# Binding to 0.0.0.0 inside the VM engages Hermes' auth gate, so a username +
# password are required (it fails closed without them). mana bootstrap
# auto-generates a readable password and a stable signing secret on first run.
#   Change the password: edit HERMES_DASHBOARD_BASIC_AUTH_PASSWORD below, then
#   run `mana hermes restart`. Keep _SECRET stable so logins survive restarts.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ── Optional ─────────────────────────────────────────────
# FIRECRAWL_API_KEY=fc-...
