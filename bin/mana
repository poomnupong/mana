#!/bin/bash
# Mana (MAc-Nix-Agent) - command index and dispatcher
#
# Usage:
#   mana [help]                 show available commands
#   mana help <command>         show detailed command help
#   mana <command> [arguments]  run a command

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
COMMAND_DIR="$REPO_DIR/libexec/mana"

show_help() {
    cat <<'EOF'
Mana (MAc-Nix-Agent)

Usage:
    mana [help]                 Show this command overview
    mana help <command>         Show detailed help for a command
    mana <command> [arguments]  Run a command

Commands:
    version     Show installed tool and application versions
    bootstrap   Set up or reconcile the complete workstation
    rebuild     Apply the current Nix configuration
    update      Update Nix, Homebrew, and the stable oMLX app
    doctor      Check oMLX and Hermes; add --fix to repair services
    services    Review and control managed services and Apple containers
    omlx        Install, update, and control the oMLX app/server
    hermes      Control or chat with the Hermes container
    uninstall   Remove one imperative component, data-safe by default

Examples:
    mana help omlx
    mana omlx status
    mana services
    mana doctor --fix
    mana hermes
    mana update
EOF
}

command_script() {
    case "$1" in
        version|bootstrap|rebuild|update|doctor|services|omlx|hermes|uninstall)
            printf '%s/%s\n' "$COMMAND_DIR" "$1"
            ;;
        *)
            return 1
            ;;
    esac
}

case "${1:-help}" in
    help|-h|--help)
        if [ "$#" -le 1 ]; then
            show_help
        else
            script="$(command_script "$2")" || {
                printf "Unknown command: %s\n\n" "$2" >&2
                show_help >&2
                exit 2
            }
            exec "$script" --help
        fi
        ;;
    *)
        command="$1"
        shift
        script="$(command_script "$command")" || {
            printf "Unknown command: %s\n\n" "$command" >&2
            show_help >&2
            exit 2
        }
        exec "$script" "$@"
        ;;
esac