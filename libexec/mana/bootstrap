#!/bin/bash
# mana — first-time bootstrap
#
# Idempotent. Safe to re-run. Each step skips itself when already done.
#
# Steps:
#   1. Sanity checks (macOS 26+ Apple silicon)
#   2. Personalize flake.nix (username + hostname)
#   3. Prompt for git identity            (skip if ~/.gitconfig has user.email)
#   4. Install Determinate Nix              (skip if `nix` present)
#   5. Install Homebrew                     (skip if `brew` present)
#   6. Apply nix-darwin flake               (always — picks up local changes)
#   7. Install/upgrade Apple `container`    (latest release from GitHub)
#   8. Install/configure official oMLX app  (latest stable DMG from GitHub)
#   9. Seed hermes/.env from .env.example   (skip if .env exists)
#   9b. Seed dashboard basic-auth creds     (skip if already set)
#  10. Start/restart Hermes                 (build only if image is missing)
#
# Usage: ./bin/mana bootstrap   (on a fresh Mac, before bin/ is on PATH)
#        mana bootstrap         (afterwards — bin/ is added to PATH by home.nix)

set -euo pipefail

case "${1:-}" in
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
esac

# Script lives in <repo>/libexec/mana/, so the repo root is two levels up.
REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_DIR"

# ── Pretty logging ───────────────────────────────────────
log()  { printf "\033[1;34m==>\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m  %s\n" "$*" >&2; }
die()  { printf "\033[1;31mxx\033[0m  %s\n" "$*" >&2; exit 1; }

request_admin() {
    log "Administrator access is required to activate the system configuration."
    printf "    Enter your macOS password at the prompt (input stays hidden).\n"
    sudo -k
    sudo -p "Administrator Password: " -v
}

# Generate a human-readable but high-entropy passphrase: 4 random dictionary
# words + a 2-digit number (e.g. "tiger-maple-cabin-river-83"). Word choice
# uses openssl's CSPRNG, not awk's seeded rand(), so it's actually secure
# (~60+ bits from a ~25k-word pool). Falls back to hex if no system wordlist.
gen_passphrase() {
    local dict="/usr/share/dict/words" pool count i idx out=""
    if [ -r "$dict" ]; then
        pool="$(LC_ALL=C grep -E '^[a-z]{4,7}$' "$dict")"
        count="$(printf '%s\n' "$pool" | grep -c '')"
        if [ "${count:-0}" -ge 1000 ]; then
            for i in 1 2 3 4; do
                idx=$(( 0x$(openssl rand -hex 4) % count + 1 ))
                out="${out:+$out-}$(printf '%s\n' "$pool" | sed -n "${idx}p")"
            done
            printf '%s-%02d\n' "$out" "$(( 0x$(openssl rand -hex 1) % 100 ))"
            return 0
        fi
    fi
    printf 'hermes-%s\n' "$(openssl rand -hex 8)"
}

# ── 1. Sanity checks ─────────────────────────────────────
log "Checking host..."
[ "$(uname -s)" = "Darwin" ] || die "macOS required."
[ "$(uname -m)" = "arm64" ]  || die "Apple silicon required."
macos_major="$(sw_vers -productVersion | cut -d. -f1)"
if [ "$macos_major" -lt 26 ]; then
    warn "macOS $macos_major detected — Apple container needs macOS 26+. Continuing, but step 5 will fail."
fi

if [ "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
    die "Do NOT run this script with sudo. It prompts for sudo only when needed."
fi

# home.nix hard-codes ~/repo/mana/bin onto PATH (kept deliberately
# simple — no path-detection wrapper). If the repo lives elsewhere everything
# still works, but the bare `mana` command won't resolve; call it as ./bin/mana
# or edit that one PATH line in home.nix. Just a heads-up, not fatal.
expected_dir="$HOME/repo/mana"
if [ "$REPO_DIR" != "$expected_dir" ]; then
    warn "Repo is at $REPO_DIR, not $expected_dir."
    warn "home.nix only adds ~/repo/mana/bin to PATH — move the repo there"
    warn "(or edit that line in home.nix) for the bare 'mana' command to work."
fi

# ── 2. Personalize flake.nix (username + hostname) ───────
current_user="$(id -un)"
current_host="$(scutil --get LocalHostName 2>/dev/null || hostname -s)"

# Personalization lives in ./local.nix (gitignored). flake.nix reads it
# via `local // defaults`, so the tracked file never needs editing —
# `git status` stays clean across re-bootstraps and upstream pulls.
local_nix="$REPO_DIR/local.nix"
local_user=""
local_host=""
if [ -f "$local_nix" ]; then
    local_user="$(awk -F\" '/^[[:space:]]*username[[:space:]]*=/ { print $2; exit }' "$local_nix")"
    local_host="$(awk -F\" '/^[[:space:]]*hostname[[:space:]]*=/ { print $2; exit }' "$local_nix")"
fi

if [ "$local_user" != "$current_user" ] || [ "$local_host" != "$current_host" ]; then
    log "Writing $local_nix"
    [ "$local_user" != "$current_user" ] && printf "    username: %s -> %s\n" "${local_user:-<unset>}" "$current_user"
    [ "$local_host" != "$current_host" ] && printf "    hostname: %s -> %s\n" "${local_host:-<unset>}" "$current_host"
    cat > "$local_nix" <<EOF
# Per-machine identity for flake.nix. Generated by mana bootstrap.
# Gitignored — safe to edit by hand. Re-run mana bootstrap to regenerate
# from \`id -un\` and \`scutil --get LocalHostName\`.
{
  username = "$current_user";
  hostname = "$current_host";
}
EOF
else
    log "local.nix already matches $current_user @ $current_host — skipping."
fi

# Build a temporary flake source from tracked files plus local.nix. This keeps
# ignored secrets/runtime data out of the Nix store and leaves Git untouched.
flake_source="$("$REPO_DIR/libexec/mana/flake-source")"
trap 'rm -rf "$flake_source"' EXIT

# ── 3. Git identity (prompt only if missing) ─────────────
# We deliberately do NOT manage git identity via home-manager: it would
# stomp ~/.gitconfig on every darwin-rebuild and leak PII back into the
# nix files we just scrubbed for public release. Use the standard global
# config instead.
#
# home-manager owns ~/.config/git/config (read-only symlink to the nix
# store), so plain `git config --global` fails with EACCES. Force writes
# to ~/.gitconfig via GIT_CONFIG_GLOBAL — git merges both files on read.
GIT_GLOBAL="$HOME/.gitconfig"
if ! GIT_CONFIG_GLOBAL="$GIT_GLOBAL" git config --global user.email >/dev/null 2>&1 \
        && ! git config --global user.email >/dev/null 2>&1; then
    log "No global git identity found — let's set it now (used for all commits)."
    printf "    git user.name  (e.g. Jane Doe)        : "
    read -r gname
    printf "    git user.email (e.g. jane@example.com): "
    read -r gemail
    [ -n "$gname" ]  && GIT_CONFIG_GLOBAL="$GIT_GLOBAL" git config --global user.name  "$gname"
    [ -n "$gemail" ] && GIT_CONFIG_GLOBAL="$GIT_GLOBAL" git config --global user.email "$gemail"
    if [ -z "$gname" ] && [ -z "$gemail" ]; then
        warn "Skipped git identity setup. Set later with: GIT_CONFIG_GLOBAL=~/.gitconfig git config --global user.{name,email} ..."
    fi
else
    log "Git identity present ($(git config --get user.email)) — skipping."
fi

# ── 4. Determinate Nix ───────────────────────────────────
if ! command -v nix >/dev/null 2>&1; then
    log "Installing Determinate Nix..."
    curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix \
        | sh -s -- install --determinate
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || true
    command -v nix >/dev/null 2>&1 || die "Nix not on PATH after install — open a new shell and re-run."
else
    log "Nix present — skipping."
fi

# ── 5. Homebrew ──────────────────────────────────────────
if ! command -v brew >/dev/null 2>&1; then
    log "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
    log "Homebrew present — skipping."
fi

# Load brew onto PATH regardless of whether it was just installed or
# already present. Homebrew shell integration isn't in the (home-manager
# managed) interactive rc, so `brew` may not be on PATH even when it's
# installed at the standard prefix — without this, step 5b's trust would
# silently no-op and darwin-rebuild would later hit the untrusted-tap error.
if ! command -v brew >/dev/null 2>&1; then
    for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$brew_bin" ] && eval "$("$brew_bin" shellenv)" && break
    done
fi

# ── 6. nix-darwin flake activation ───────────────────────
log "Applying nix-darwin flake (sudo)..."
request_admin
"$REPO_DIR/libexec/mana/brew-preflight"
if command -v darwin-rebuild >/dev/null 2>&1; then
    sudo darwin-rebuild switch --flake "path:$flake_source"
else
    sudo nix run nix-darwin#darwin-rebuild -- switch --flake "path:$flake_source"
fi

# ── 7. Apple `container` runtime (install or upgrade) ────
# Apple's container .pkg ships /usr/local/bin/update-container.sh for
# in-place upgrades. We always check the latest release tag against the
# installed version and act accordingly.
log "Checking Apple container runtime..."
container_release_api="https://api.github.com/repos/apple/container/releases/latest"
container_releases_url="https://github.com/apple/container/releases"
container_release_json=""
if container_release_json="$(curl -fsSL "$container_release_api" 2>/dev/null)"; then
    latest_tag="$(printf '%s\n' "$container_release_json" \
        | awk -F\" '/"tag_name":/ { print $4; exit }')"
else
    warn "GitHub Releases API unavailable — using the public release page."
    latest_release_url="$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "$container_releases_url/latest")"
    latest_tag="${latest_release_url##*/}"
fi
[ -n "$latest_tag" ] || die "Could not resolve the latest Apple container release."
latest_ver="${latest_tag#v}"

if command -v container >/dev/null 2>&1; then
    current_ver="$(container --version 2>/dev/null | awk '{print $NF}' | head -n1)"
    if [ -n "$latest_ver" ] && [ "$current_ver" != "$latest_ver" ]; then
        log "Upgrading Apple container: $current_ver -> $latest_ver"
        if [ -x /usr/local/bin/update-container.sh ]; then
            sudo /usr/local/bin/update-container.sh
        else
            warn "update-container.sh not found — falling back to .pkg reinstall."
            install_container=1
        fi
    else
        log "Apple container up to date ($current_ver) — skipping."
    fi
else
    install_container=1
fi

if [ "${install_container:-0}" = "1" ]; then
    log "Installing Apple container runtime ($latest_tag)..."
    pkg_url="$(printf '%s\n' "$container_release_json" \
        | grep -oE 'https://[^"]+\.pkg' \
        | grep -v 'unsigned' \
        | head -n1 || true)"
    if [ -z "$pkg_url" ]; then
        pkg_path="$(curl -fsSL "$container_releases_url/expanded_assets/$latest_tag" \
            | grep -oE 'href="[^"]+\.pkg"' \
            | cut -d\" -f2 \
            | grep -v 'unsigned' \
            | head -n1 || true)"
        case "$pkg_path" in
            https://*) pkg_url="$pkg_path" ;;
            /*) pkg_url="https://github.com$pkg_path" ;;
        esac
    fi
    [ -n "$pkg_url" ] || die "Could not resolve container .pkg URL from GitHub."
    tmp_pkg="$(mktemp -t container).pkg"
    log "Downloading $pkg_url"
    curl -fsSL -o "$tmp_pkg" "$pkg_url"
    log "Installing (sudo)..."
    sudo installer -pkg "$tmp_pkg" -target /
    rm -f "$tmp_pkg"
fi

log "Starting container system..."
container system start 2>/dev/null || true

# ── 8. oMLX official app + settings ──────────────────────
# The official DMG embeds its Python/MLX runtime, avoiding source builds
# and PyPI downloads. The app-managed server reads settings.json. Ensure:
#   .server.host  = "0.0.0.0"        (so the VM at 192.168.64.x can reach it)
#   .auth.api_key = <generated key>  (used for Bearer auth)
log "Installing/upgrading the official oMLX app..."
"$REPO_DIR/libexec/mana/omlx" install

omlx_settings="$HOME/.omlx/settings.json"
mkdir -p "$HOME/.omlx"

if [ ! -f "$omlx_settings" ]; then
    log "Creating initial oMLX settings.json..."
    printf '%s\n' '{"version":"1.0","server":{},"auth":{},"model":{"model_dir":"~/.omlx/models","model_dirs":["~/.omlx/models"]},"sampling":{}}' > "$omlx_settings"
    chmod 600 "$omlx_settings"
fi

command -v jq >/dev/null 2>&1 || die "jq is required (installed by nix-darwin home.nix in step 4 — re-open shell?)."

needs_restart=0
host="$(jq -r '.server.host // empty' "$omlx_settings")"
settings_key="$(jq -r '.auth.api_key // empty' "$omlx_settings")"
[ "$settings_key" = "null" ] && settings_key=""

# Read existing key from hermes/.env if present — fallback source of truth
# so a wiped settings.json (oMLX upgrade, manual reset) doesn't silently
# invalidate the key already in use by clients.
env_key=""
if [ -f "$REPO_DIR/hermes/.env" ]; then
    env_key="$(awk -F= '/^OMLX_API_KEY=/ { sub(/^OMLX_API_KEY=/, ""); print; exit }' "$REPO_DIR/hermes/.env")"
fi

# Precedence:
#   1. settings.json has a key  → use it (oMLX is the auth server)
#   2. .env has a key           → reuse it (don't break existing clients)
#   3. neither                  → generate a new one
if [ -n "$settings_key" ]; then
    key="$settings_key"
elif [ -n "$env_key" ]; then
    key="$env_key"
    log "Reusing OMLX_API_KEY from hermes/.env (settings.json was missing it)"
else
    key="omlx-sk-$(openssl rand -hex 24)"
    log "Generating new oMLX API key"
fi

if [ "$host" != "0.0.0.0" ]; then
    log "Setting oMLX bind host = 0.0.0.0"
    tmp="$(mktemp)"
    jq '.server.host = "0.0.0.0"' "$omlx_settings" > "$tmp" && mv "$tmp" "$omlx_settings"
    needs_restart=1
fi

if [ "$settings_key" != "$key" ]; then
    log "Writing oMLX API key into settings.json"
    tmp="$(mktemp)"
    jq --arg k "$key" '.auth.api_key = $k | .auth.skip_api_key_verification = false' \
        "$omlx_settings" > "$tmp" && mv "$tmp" "$omlx_settings"
    chmod 600 "$omlx_settings"
    needs_restart=1
fi

# Global sampling fallback for any model without an explicit per-model
# `max_context_window`. We pin 65536 (64Ki) to match `hermes/config.yaml`'s
# `model.context_length` and clear Hermes Agent's hard 64K minimum (it
# refuses to start below 64,000 tokens). Per-model overrides remain the
# user's responsibility — set them from the oMLX admin UI after downloading
# a model (Models → <model> → Settings → max_context_window). The repo
# deliberately does NOT pre-pin settings for models it doesn't ship.
global_ctx="$(jq -r '.sampling.max_context_window // empty' "$omlx_settings")"
if [ "$global_ctx" != "65536" ]; then
    log "Setting oMLX global sampling.max_context_window = 65536"
    tmp="$(mktemp)"
    jq '.sampling.max_context_window = 65536' "$omlx_settings" > "$tmp" && mv "$tmp" "$omlx_settings"
    needs_restart=1
fi

# settings.json contains the API key. Repair permissive modes on every run,
# including files created or rewritten outside bootstrap.
chmod 600 "$omlx_settings"

log "Starting/restarting oMLX"
"$REPO_DIR/libexec/mana/omlx" restart >/dev/null

omlx_key="$key"

# ── 9. hermes/.env ───────────────────────────────────────
if [ ! -f "$REPO_DIR/hermes/.env" ]; then
    log "Creating hermes/.env from .env.example"
    cp "$REPO_DIR/hermes/.env.example" "$REPO_DIR/hermes/.env"
fi
chmod 600 "$REPO_DIR/hermes/.env"

# Migrate legacy OPENAI_API_KEY entry to OMLX_API_KEY if present
if grep -qE '^OPENAI_API_KEY=' "$REPO_DIR/hermes/.env" && ! grep -qE '^OMLX_API_KEY=' "$REPO_DIR/hermes/.env"; then
    log "Migrating OPENAI_API_KEY → OMLX_API_KEY in hermes/.env"
    sed -i.bak "s|^OPENAI_API_KEY=|OMLX_API_KEY=|" "$REPO_DIR/hermes/.env"
    rm -f "$REPO_DIR/hermes/.env.bak"
fi

current_key="$(awk -F= '/^OMLX_API_KEY=/ { sub(/^OMLX_API_KEY=/, ""); print; exit }' "$REPO_DIR/hermes/.env")"
if [ "$current_key" != "$omlx_key" ]; then
    log "Syncing OMLX_API_KEY in hermes/.env with oMLX key"
    if grep -q '^OMLX_API_KEY=' "$REPO_DIR/hermes/.env"; then
        sed -i.bak "s|^OMLX_API_KEY=.*|OMLX_API_KEY=$omlx_key|" "$REPO_DIR/hermes/.env"
    else
        cp "$REPO_DIR/hermes/.env" "$REPO_DIR/hermes/.env.bak"
        printf 'OMLX_API_KEY=%s\n' "$omlx_key" >> "$REPO_DIR/hermes/.env"
    fi
    rm -f "$REPO_DIR/hermes/.env.bak"
fi

# ── 9b. Dashboard basic-auth credentials (browser GUI) ───
# The container runs `hermes dashboard` bound to 0.0.0.0, which engages
# Hermes' auth gate — without credentials it fails closed. Seed a readable
# password + a stable signing secret once, then leave them alone. Published
# only to 127.0.0.1:9119, so this guards loopback access on this Mac.
envf="$REPO_DIR/hermes/.env"

# Set KEY=VALUE in hermes/.env only when the key is missing or empty (so a
# user-chosen password is never clobbered on a re-run).
seed_env_if_empty() {
    local key="$1" val="$2" cur
    if grep -qE "^${key}=" "$envf"; then
        cur="$(grep -E "^${key}=" "$envf" | head -1 | cut -d= -f2-)"
        [ -n "$cur" ] && return 0
        # base64/passphrase values contain no '|', safe as the sed delimiter
        sed -i.bak "s|^${key}=.*|${key}=${val}|" "$envf" && rm -f "${envf}.bak"
    else
        printf '%s=%s\n' "$key" "$val" >> "$envf"
    fi
}

seed_env_if_empty HERMES_DASHBOARD_BASIC_AUTH_USERNAME "admin"
seed_env_if_empty HERMES_DASHBOARD_BASIC_AUTH_PASSWORD "$(gen_passphrase)"
seed_env_if_empty HERMES_DASHBOARD_BASIC_AUTH_SECRET   "$(openssl rand -base64 32)"

dash_user="$(grep -E '^HERMES_DASHBOARD_BASIC_AUTH_USERNAME=' "$envf" | head -1 | cut -d= -f2-)"
dash_pass="$(grep -E '^HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=' "$envf" | head -1 | cut -d= -f2-)"

# ── 10. Hermes container ─────────────────────────────────
log "Starting/restarting Hermes container..."
"$REPO_DIR/hermes/run.sh" restart

configured_model="$(awk '/^[[:space:]]*default:[[:space:]]*/ { sub(/^[[:space:]]*default:[[:space:]]*/, ""); gsub(/^['\"']|['\"']$/, ""); print; exit }' "$REPO_DIR/hermes/config.yaml")"
model_ids="$("$REPO_DIR/libexec/mana/omlx" models 2>/dev/null || true)"
if [ -z "$model_ids" ]; then
        next_step="Next: open the oMLX admin UI, download and load a model, set model.default
            in hermes/config.yaml to its served ID, then run './bin/mana hermes up'."
elif printf '%s\n' "$model_ids" | grep -qFx "$configured_model"; then
        next_step="Ready: ${configured_model} is available. Open the dashboard or start a chat."
else
        first_model="$(printf '%s\n' "$model_ids" | head -n1)"
        next_step="Next: oMLX is serving ${first_model}, but Hermes expects ${configured_model}.
            Update model.default in hermes/config.yaml, then run './bin/mana hermes up'."
fi

cat <<EOF

$(printf "\033[1;32mBootstrap complete.\033[0m")

    Next shell:  open a new terminal (or run 'exec zsh') so ~/repo/mana/bin
                             lands on PATH and the bare 'mana' command resolves. Until then,
                             call it as ./bin/mana from the repo root.

  oMLX admin:  http://127.0.0.1:8000/admin
  Hermes dash: http://localhost:9119
               login: ${dash_user} / ${dash_pass}
               change: edit HERMES_DASHBOARD_BASIC_AUTH_PASSWORD in hermes/.env,
                       then run 'mana hermes restart'
  Attach:      container exec -it hermes-agent bash
    Chat now:    ./bin/mana hermes
    Browser GUI: ./bin/mana hermes dashboard

${next_step}
EOF
