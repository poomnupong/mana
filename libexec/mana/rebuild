#!/bin/bash
# mana - apply the current nix-darwin configuration
# Usage: mana rebuild

set -euo pipefail

case "${1:-}" in
    -h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
    "") ;;
    *) echo "Unknown option: $1 (try --help)" >&2; exit 2 ;;
esac

REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_DIR"

[ -f local.nix ] || {
    echo "local.nix is missing; run mana bootstrap first." >&2
    exit 1
}

# Build a temporary flake source from tracked files plus local.nix. This keeps
# ignored secrets/runtime data out of the Nix store and leaves Git untouched.
flake_source="$("$REPO_DIR/libexec/mana/flake-source")"
trap 'rm -rf "$flake_source"' EXIT

echo "Applying nix-darwin flake (sudo)..."
sudo -k
sudo -p "Administrator Password: " -v
"$REPO_DIR/libexec/mana/brew-preflight"
if command -v darwin-rebuild >/dev/null 2>&1; then
    sudo darwin-rebuild switch --flake "path:$flake_source"
else
    sudo nix run nix-darwin#darwin-rebuild -- switch --flake "path:$flake_source"
fi