#!/bin/bash
# mana — update Nix, Homebrew, and the stable oMLX app
#
# This upgrades Homebrew visibly before nix-darwin activation, updates the
# flake, and then updates the official oMLX app from its stable DMG channel.
#
# Usage: mana update [--no-flake] [--no-brew]
#   --no-flake   skip `nix flake update` (rebuild against the pinned lock)
#   --no-brew    skip the explicit verbose `brew upgrade`

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_DIR"

log()  { printf "\033[1;34m==>\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m  %s\n" "$*" >&2; }
die()  { printf "\033[1;31mxx\033[0m  %s\n" "$*" >&2; exit 1; }

request_admin() {
    log "Administrator access is required to update and activate the system configuration."
    printf "    Enter your macOS password at the prompt (input stays hidden).\n"
    sudo -k
    sudo -p "Administrator Password: " -v
}

do_flake=1
do_brew=1
for arg in "$@"; do
    case "$arg" in
        --no-flake) do_flake=0 ;;
        --no-brew)  do_brew=0 ;;
        -h|--help)  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
        *) die "Unknown option: $arg (try --help)" ;;
    esac
done

request_admin

# ── Load Homebrew onto PATH ──────────────────────────────
# home-manager's interactive rc doesn't run `brew shellenv`, so `brew`
# may be installed but not resolvable. Load it from the standard prefix.
if ! command -v brew >/dev/null 2>&1; then
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$b" ] && eval "$("$b" shellenv)" && break
    done
fi

# Legacy root-run Python services can leave root-owned bytecode caches inside
# Homebrew. Remove only those generated caches before upgrade/cleanup runs.
"$REPO_DIR/libexec/mana/brew-preflight"

# ── 1. Homebrew (verbose, so it's not the silent stall) ──
if [ "$do_brew" -eq 1 ] && command -v brew >/dev/null 2>&1; then
    log "Updating Homebrew metadata..."
    brew update
    outdated="$(brew outdated --quiet 2>/dev/null || true)"
    if [ -n "$outdated" ]; then
        log "Upgrading outdated formulae/casks (verbose):"
        printf '    %s\n' $outdated
        brew upgrade --verbose
    else
        log "Homebrew already up to date — skipping upgrade."
    fi
elif [ "$do_brew" -eq 1 ]; then
    warn "brew not found — skipping Homebrew upgrade."
fi

# ── 2. Flake inputs ──────────────────────────────────────
if [ "$do_flake" -eq 1 ]; then
    log "Bumping flake inputs (nix flake update)..."
    nix flake update
else
    log "Skipping flake update (--no-flake) — rebuilding against pinned lock."
fi

# ── 3. Rebuild nix-darwin ────────────────────────────────
# Activation reconciles the declared Homebrew inventory without upgrading it.
log "Applying nix-darwin flake (sudo)..."
flake_source="$("$REPO_DIR/libexec/mana/flake-source")"
trap 'rm -rf "$flake_source"' EXIT
if command -v darwin-rebuild >/dev/null 2>&1; then
    sudo darwin-rebuild switch --flake "path:$flake_source"
else
    sudo nix run nix-darwin#darwin-rebuild -- switch --flake "path:$flake_source"
fi

# ── 4. Official oMLX app ─────────────────────────────────
log "Checking the stable oMLX app channel..."
"$REPO_DIR/libexec/mana/omlx" upgrade
"$REPO_DIR/libexec/mana/omlx" restart \
    || die "Dependencies updated, but oMLX restart failed. Run 'mana doctor'."

printf "\n\033[1;32mUpdate complete.\033[0m  Verify oMLX with: mana omlx status\n"
