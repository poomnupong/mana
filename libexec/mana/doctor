#!/bin/bash
# mana - health check and repair for the oMLX and Hermes stack
#
# Default run only reports. Pass --fix to remove stale launch agents and
# restore the app-managed server and containerized Hermes agent.
#
# Usage: mana doctor [--fix [--yes]]

set -uo pipefail

REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
APP="/Applications/oMLX.app"
APP_CLI="$APP/Contents/MacOS/omlx-cli"
USER_CLI="$HOME/.omlx/bin/omlx"
HERMES_RUN="$REPO_DIR/hermes/run.sh"
PORT=8000
NIX_LABEL="org.nixos.omlx"
BREW_LABEL="homebrew.mxcl.omlx"
issues=0

FIX=0
ASSUME_YES=0
for argument in "$@"; do
    case "$argument" in
        --fix) FIX=1 ;;
        --yes) ASSUME_YES=1 ;;
        -h|--help)
            sed -n '2,7p' "$0"
            printf '\n--fix warns and asks before disruptive repairs. --yes skips that prompt.\n'
            exit 0 ;;
        *) printf "Unknown option: %s (try --help)\n" "$argument" >&2; exit 2 ;;
    esac
done
if [ "$ASSUME_YES" -eq 1 ] && [ "$FIX" -eq 0 ]; then
    printf '%s\n' '--yes requires --fix.' >&2
    exit 2
fi
if [ "$FIX" -eq 1 ]; then
    printf 'Warning: repairs may install oMLX, remove legacy services, stop ANY listener on port 8000, and restart oMLX/Hermes. Active work may be interrupted. Persistent data is kept.\n' >&2
    if [ "$ASSUME_YES" -eq 0 ]; then
        printf 'Proceed? [y/N] ' >&2
        read -r reply || exit 1
        case "$reply" in y|Y|yes|YES) ;; *) printf 'Cancelled.\n' >&2; exit 1 ;; esac
    fi
fi

ok()     { printf "\033[1;32m  ok\033[0m   %s\n" "$*"; }
bad()    { printf "\033[1;31m fail\033[0m  %s\n" "$*"; issues=$((issues + 1)); }
info()   { printf "\033[1;34m info\033[0m  %s\n" "$*"; }
fixmsg() { printf "\033[1;35m  fix\033[0m  %s\n" "$*"; }

if ! command -v brew >/dev/null 2>&1; then
    for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$brew_bin" ] && eval "$("$brew_bin" shellenv)" && break
    done
fi

printf "\033[1mmana doctor\033[0m  (mode: %s)\n\n" \
    "$( [ "$FIX" -eq 1 ] && echo 'REPAIR' || echo 'report-only' )"

if [ -d "$APP" ]; then
    version="$(/usr/bin/defaults read "$APP/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null)"
    ok "Official oMLX.app installed (${version:-unknown version})."
else
    bad "Official oMLX.app is missing - run 'mana omlx install'."
    if [ "$FIX" -eq 1 ]; then
        "$REPO_DIR/libexec/mana/omlx" install && fixmsg "installed the latest stable oMLX app"
    fi
fi

for label in "$NIX_LABEL" "$BREW_LABEL"; do
    plist="$HOME/Library/LaunchAgents/${label}.plist"
    if launchctl list 2>/dev/null | grep -q "$label" || [ -f "$plist" ]; then
        bad "Stale '$label' launch agent can conflict with the app-managed server."
        if [ "$FIX" -eq 1 ]; then
            launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
            rm -f "$plist"
            fixmsg "removed $label"
        fi
    else
        ok "No stale '$label' launch agent."
    fi
done

if command -v brew >/dev/null 2>&1 && brew list --versions jundot/omlx/omlx >/dev/null 2>&1; then
    bad "The superseded Homebrew oMLX formula is still installed."
    if [ "$FIX" -eq 1 ]; then
        brew services stop jundot/omlx/omlx >/dev/null 2>&1 || true
        brew unpin jundot/omlx/omlx >/dev/null 2>&1 || true
        HOMEBREW_NO_AUTOREMOVE=1 brew uninstall jundot/omlx/omlx \
            && fixmsg "removed the Homebrew formula"
    fi
else
    ok "No superseded Homebrew oMLX formula."
fi

if [ -x "$USER_CLI" ]; then
    ok "App CLI shim installed at $USER_CLI."
elif [ -x "$APP_CLI" ]; then
    info "App CLI shim is not installed yet; launching the app will create it."
else
    bad "No app-managed oMLX CLI is available."
fi

holder_pid="$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -n1)"
if [ -n "$holder_pid" ]; then
    holder_cmd="$(ps -p "$holder_pid" -o command= 2>/dev/null)"
    if printf '%s' "$holder_cmd" | grep -q '/oMLX.app/' \
            || lsof -p "$holder_pid" 2>/dev/null | awk '$4 == "txt" { print $9 }' \
                | grep -q '^/Applications/oMLX.app/'; then
        if pgrep -f '/oMLX.app/Contents/MacOS/oMLX' >/dev/null 2>&1; then
            ok "Port $PORT held by the official oMLX app (pid $holder_pid)."
        else
            bad "The bundled oMLX server is running without its supervising app."
        fi
    else
        bad "Port $PORT held outside oMLX.app (pid $holder_pid: $holder_cmd)."
        if [ "$FIX" -eq 1 ]; then
            if kill "$holder_pid"; then
                fixmsg "sent termination to the conflicting listener on :$PORT"
            else
                info "Could not stop the conflicting listener."
            fi
        fi
    fi
else
    bad "Nothing is listening on :$PORT."
fi

settings="$HOME/.omlx/settings.json"
if [ -f "$settings" ] && command -v jq >/dev/null 2>&1; then
    key="$(jq -r '.auth.api_key // empty' "$settings")"
    code="$(curl -s -m 5 -o /dev/null -w '%{http_code}' \
        -H "Authorization: Bearer $key" "http://127.0.0.1:$PORT/v1/models" 2>/dev/null)"
    if [ "$code" = "200" ]; then
        count="$(curl -s -m 5 -H "Authorization: Bearer $key" \
            "http://127.0.0.1:$PORT/v1/models" 2>/dev/null | jq '.data | length' 2>/dev/null)"
        ok "API http://127.0.0.1:$PORT -> HTTP 200 (${count:-?} model(s) available)."
    else
        bad "API http://127.0.0.1:$PORT -> HTTP ${code:-000}."
        info "Inspect server errors with 'mana omlx logs'."
    fi
else
    bad "No readable ~/.omlx/settings.json - run mana bootstrap."
fi

if [ "$FIX" -eq 1 ] && [ -d "$APP" ]; then
    "$REPO_DIR/libexec/mana/omlx" restart \
        && fixmsg "restarted the app-managed server" \
        || info "Restart failed; open oMLX.app to inspect its status."
fi

if ! command -v container >/dev/null 2>&1; then
    bad "Apple container CLI is missing - run 'mana bootstrap'."
else
    ok "Apple container CLI is installed."
    container_ready=0
    if container system status 2>/dev/null | grep -q 'running'; then
        ok "Apple container system is running."
        container_ready=1
    else
        bad "Apple container system is not running."
        if [ "$FIX" -eq 1 ]; then
            if container system start >/dev/null 2>&1; then
                fixmsg "started the Apple container system"
                container_ready=1
            else
                info "Container system failed to start; run 'container system start' for details."
            fi
        fi
    fi

    if [ "$container_ready" -eq 1 ]; then
        if "$HERMES_RUN" status; then
            ok "Hermes container and required endpoints are responding."
        else
            bad "Hermes is missing, stopped, or unhealthy."
            if [ "$FIX" -eq 1 ]; then
                if "$HERMES_RUN" restart; then
                    fixmsg "restored Hermes health"
                else
                    info "Hermes repair failed; run 'mana hermes up' for details."
                fi
            fi
        fi
    fi
fi

echo
if [ "$FIX" -eq 1 ]; then
    printf 'Repair pass finished. Rechecking without repairs...\n\n'
    exec "$0"
elif [ "$issues" -eq 0 ]; then
    printf "\033[1;32mAll checks passed.\033[0m\n"
    exit 0
else
    printf "\033[1;31mFound %d issue(s).\033[0m Re-run with '--fix' to repair automatically.\n" "$issues"
    exit 1
fi